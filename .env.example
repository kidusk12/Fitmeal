# Copy this file to .env and fill in real values. NEVER commit .env.
BOT_TOKEN=put-your-botfather-token-here
# Comma-separated Telegram IDs of the owner(s)
ADMIN_IDS=123456789
# Local development database (replace user, password and name with yours)
DATABASE_URL=postgresql://postgres:YOURPASSWORD@localhost:5432/fitmeal_dev
TIMEZONE=Africa/Addis_Ababa
LOG_LEVEL=INFO

# Phase 8 (all optional)
# BACKUP_TIME=03:00        daily backup time (Addis Ababa time)
# BACKUP_KEEP=14           how many backup files to keep
# BACKUP_SEND=1            send the daily backup to the owners on Telegram (0 = keep it on the server only)
# BACKUP_DIR=              folder for backups (default: backups next to the code)
# STARTUP_NOTICE=1         message the owners each time the bot starts (0 = off)
