# Copy this file to .env and fill in real values. NEVER commit .env.
BOT_TOKEN=put-your-botfather-token-here
# Comma-separated Telegram IDs of the owner(s)
ADMIN_IDS=123456789
# Local development database (replace user, password and name with yours)
DATABASE_URL=postgresql://postgres:YOURPASSWORD@localhost:5432/fitmeal_dev
TIMEZONE=Africa/Addis_Ababa
LOG_LEVEL=INFO
